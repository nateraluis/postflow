[Unit]
Description=PostFlow APScheduler
After=network-online.target
PartOf=postflow.target

[Service]
Type=simple
User=postflow
Group=postflow
WorkingDirectory=/home/postflow/app
EnvironmentFile=/home/postflow/app/core/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=DEBUG=False
ExecStart=/home/postflow/app/.venv/bin/python manage.py run_scheduler
Restart=always
RestartSec=10
StandardOutput=append:/var/log/postflow/scheduler.log
StandardError=append:/var/log/postflow/scheduler.log

[Install]
WantedBy=postflow.target
