[Unit]
Description=PostFlow uWSGI Web Server
After=network-online.target
PartOf=postflow.target

[Service]
Type=notify
User=postflow
Group=postflow
WorkingDirectory=/home/postflow/app
EnvironmentFile=/home/postflow/app/core/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=DEBUG=False
ExecStart=/home/postflow/app/.venv/bin/uwsgi \
    --http-socket 127.0.0.1:8010 \
    --wsgi core.wsgi:application \
    --master \
    --processes 2 \
    --threads 2 \
    --harakiri 120 \
    --max-requests 5000 \
    --vacuum \
    --die-on-term \
Restart=always
RestartSec=5
KillSignal=SIGQUIT

[Install]
WantedBy=postflow.target
