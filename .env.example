# PostFlow environment configuration
# Copy to core/.env and fill in real values. django-environ reads core/.env.

# --- Django ---
DJANGO_SECRET_KEY=changeme
DEBUG=True

# --- Database (PostgreSQL) ---
DB_NAME=postflow
DB_USER=postflow
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# --- Meta / Instagram Business ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_REDIRECT_URI=https://postflow.photo/accounts/instagram/business/callback/

# --- Mastodon / Pixelfed OAuth redirect URIs (prod only; DEBUG uses localhost) ---
REDIRECT_URI=https://postflow.photo/mastodon/callback
PIXELFED_REDIRECT_URI=https://postflow.photo/pixelfed/callback

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- S3 storage (prod only) ---
S3_AWS_STORAGE_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_STORAGE_MEDIA_BUCKET_NAME=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_ACCESS_KEY=

# --- Claude API (AI drafting + campaign evaluation) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DRAFTING=claude-sonnet-5
ANTHROPIC_MODEL_ANALYSIS=claude-opus-4-8

# --- Subscription gating ---
# Comma-separated emails that bypass Stripe (e.g. the owner account)
SUBSCRIPTION_EXEMPT_EMAILS=

# --- LinkedIn (Share on LinkedIn product) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://postflow.photo/linkedin/callback/

# --- Threads (Meta Threads API) ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://postflow.photo/threads/callback/

# --- Credential encryption at rest ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means reconnecting every social account.
FIELD_ENCRYPTION_KEY=

# --- One-time photo-analytics history import (optional) ---
GITHUB_ANALYTICS_TOKEN=
PHOTO_ANALYTICS_REPO=Tyn-Studio/photo-analytics
